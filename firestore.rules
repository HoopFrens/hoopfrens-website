rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function publishedRead() {
      return resource.data.get('published', false) == true;
    }

    function isInternalKnowledgeCollection(collectionName) {
      return collectionName.matches('internalKnowledge.*');
    }

    function isRestrictedInternalCollection(collectionName) {
      return isInternalKnowledgeCollection(collectionName)
        || collectionName == 'internalFounderWorkflowDrafts'
        || collectionName == 'internalProductionPackages'
        || collectionName == 'internalSchoolSpotlightPackageFacts'
        || collectionName == 'internalSchoolSpotlightPackageFactsA'
        || collectionName == 'internalSchoolSpotlightPackageFactsB'
        || collectionName == 'internalSchoolSpotlightPackageContent'
        || collectionName == 'internalSchoolSpotlightPackageDelivery'
        || collectionName == 'internalSchoolSpotlightPackageRequest'
        || collectionName == 'internalSchoolSpotlightPackageCustomization'
        || collectionName == 'internalProjects';
    }

    function isIdentifier(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 256
        && value.matches('[A-Za-z0-9][A-Za-z0-9._-]*');
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0 && value.size() <= 4096;
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function boundedString(value, maximumSize) {
      return value is string && value.size() <= maximumSize;
    }

    function optionalIdentifier(data, field) {
      return !(field in data) || isIdentifier(data[field]);
    }

    function validHttpUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 4096
        && value.matches('https?://.+');
    }

    function optionalHttpUrl(data, field) {
      return !(field in data) || validHttpUrl(data[field]);
    }

    function validStringList(value, maximumSize) {
      return value is list
        && value.size() <= maximumSize
        && value.toSet().size() == value.size();
    }

    function validIdentifierListItem(value, index) {
      return value.size() <= index || isIdentifier(value[index]);
    }

    function validIdentifierList(value, maximumSize) {
      return validStringList(value, maximumSize)
        && validIdentifierListItem(value, 0)
        && validIdentifierListItem(value, 1)
        && validIdentifierListItem(value, 2)
        && validIdentifierListItem(value, 3);
    }

    function validTextListItem(value, index) {
      return value.size() <= index || isNonEmptyString(value[index]);
    }

    function validSmallTextList(value, maximumSize) {
      return validStringList(value, maximumSize)
        && validTextListItem(value, 0)
        && validTextListItem(value, 1)
        && validTextListItem(value, 2)
        && validTextListItem(value, 3);
    }

    function isKnowledgeStatus(value) {
      return value == 'active' || value == 'archived';
    }

    function isKnowledgeConfidence(value) {
      return value == 'verified'
        || value == 'supported'
        || value == 'inferred'
        || value == 'unverified'
        || value == 'conflicting';
    }

    function isKnowledgeNodeType(value) {
      return value == 'school' || value == 'coach' || value == 'conference'
        || value == 'player' || value == 'facility' || value == 'region'
        || value == 'state' || value == 'organization' || value == 'project'
        || value == 'content';
    }

    function isKnowledgeRegion(value) {
      return value in [
        'northeast', 'mid_atlantic', 'southeast', 'gulf_states',
        'greater_lakes', 'midwest', 'texas', 'southwest', 'northwest'
      ];
    }

    function isExclusiveRelationshipType(value) {
      return value in [
        'SCHOOL_BELONGS_TO_CONFERENCE', 'CONFERENCE_GOVERNS_SCHOOL',
        'SCHOOL_LOCATED_IN_STATE', 'SCHOOL_LOCATED_IN_REGION',
        'SCHOOL_HAS_COACH', 'COACH_WORKS_AT_SCHOOL',
        'SCHOOL_HAS_FACILITY', 'FACILITY_BELONGS_TO_SCHOOL'
      ];
    }

    function relationshipFamily(value) {
      return value in ['SCHOOL_BELONGS_TO_CONFERENCE', 'CONFERENCE_GOVERNS_SCHOOL']
          ? 'school-conference'
        : value == 'SCHOOL_LOCATED_IN_STATE' ? 'school-state'
        : value == 'SCHOOL_LOCATED_IN_REGION' ? 'school-region'
        : value in ['SCHOOL_HAS_COACH', 'COACH_WORKS_AT_SCHOOL'] ? 'school-coach'
        : value in ['SCHOOL_HAS_FACILITY', 'FACILITY_BELONGS_TO_SCHOOL'] ? 'school-facility'
        : value == 'PLAYER_CONNECTED_TO_SCHOOL' ? 'player-school'
        : value == 'PROJECT_ABOUT_SCHOOL' ? 'project-school'
        : value == 'CONTENT_ABOUT_SCHOOL' ? 'content-school'
        : '';
    }

    function relationshipUsesReverseCanonicalDirection(value) {
      return value == 'CONFERENCE_GOVERNS_SCHOOL'
        || value == 'COACH_WORKS_AT_SCHOOL'
        || value == 'FACILITY_BELONGS_TO_SCHOOL';
    }

    function isSourceType(value) {
      return value == 'official' || value == 'institutional' || value == 'publication'
        || value == 'document' || value == 'founder' || value == 'other';
    }

    function isSourceReliability(value) {
      return value == 'official' || value == 'high' || value == 'medium'
        || value == 'low' || value == 'unverified';
    }

    function createAttribution(data) {
      return data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function updateAttribution(data) {
      return data.createdBy == resource.data.createdBy
        && data.createdAt == resource.data.createdAt
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function legacyHistoryPreserved(nextHistory, previousHistory) {
      return previousHistory.size() <= 4
        && (previousHistory.size() <= 0 || nextHistory.get('v1', {}) == previousHistory[0])
        && (previousHistory.size() <= 1 || nextHistory.get('v2', {}) == previousHistory[1])
        && (previousHistory.size() <= 2 || nextHistory.get('v3', {}) == previousHistory[2])
        && (previousHistory.size() <= 3 || nextHistory.get('v4', {}) == previousHistory[3]);
    }

    function historyPreserved(nextHistory, previousHistory) {
      return nextHistory is map
        && (
          (previousHistory is list && legacyHistoryPreserved(nextHistory, previousHistory))
          || (previousHistory is map && mapHistoryPreserved(nextHistory, previousHistory))
        );
    }

    function mapHistoryPreserved(nextHistory, previousHistory) {
      let changes = nextHistory.diff(previousHistory);
      return changes.removedKeys().size() == 0 && changes.changedKeys().size() == 0;
    }

    function validLatestVersion(data) {
      let entry = data.versionHistory.get(data.latestVersionKey, {});
      return entry.version == data.version
        && entry.changedBy == request.auth.uid
        && entry.changedAt == request.time
        && isNonEmptyString(entry.reason);
    }

    function validLatestConfidence(data, priorConfidence) {
      let entry = data.confidenceHistory.get(data.latestConfidenceKey, {});
      return entry is map
        && entry.keys().hasOnly(['version', 'from', 'to', 'changedAt', 'changedBy', 'reason', 'sourceIds'])
        && entry.version == data.version
        && entry.from == priorConfidence
        && entry.to == data.confidence
        && entry.changedBy == request.auth.uid
        && entry.changedAt == request.time
        && entry.sourceIds == data.sourceIds
        && isNonEmptyString(entry.reason);
    }

    function validLatestStatus(data, priorStatus) {
      let entry = data.statusHistory.get(data.latestStatusKey, {});
      return entry is map
        && entry.keys().hasOnly(['version', 'from', 'to', 'changedAt', 'changedBy', 'reason'])
        && entry.version == data.version
        && entry.from == priorStatus
        && entry.to == data.status
        && entry.changedBy == request.auth.uid
        && entry.changedAt == request.time
        && isNonEmptyString(entry.reason);
    }

    function validCurrentConfidencePointer(data) {
      let entry = data.confidenceHistory.get(data.latestConfidenceKey, {});
      return isNonEmptyString(data.latestConfidenceKey)
        && entry is map
        && entry.keys().hasAll(['version', 'from', 'to', 'changedAt', 'changedBy', 'reason', 'sourceIds'])
        && entry.keys().hasOnly(['version', 'from', 'to', 'changedAt', 'changedBy', 'reason', 'sourceIds'])
        && entry.version is int && entry.version > 0 && entry.version <= data.version
        && isKnowledgeConfidence(entry.from)
        && entry.to == data.confidence
        && entry.changedAt is timestamp && isNonEmptyString(entry.changedBy)
        && isNonEmptyString(entry.reason)
        && entry.sourceIds == data.sourceIds;
    }

    function validCurrentStatusPointer(data) {
      let entry = data.statusHistory.get(data.latestStatusKey, {});
      return isNonEmptyString(data.latestStatusKey)
        && entry is map
        && entry.keys().hasAll(['version', 'from', 'to', 'changedAt', 'changedBy', 'reason'])
        && entry.keys().hasOnly(['version', 'from', 'to', 'changedAt', 'changedBy', 'reason'])
        && entry.version is int && entry.version > 0 && entry.version <= data.version
        && isKnowledgeStatus(entry.from)
        && entry.to == data.status
        && entry.changedAt is timestamp && isNonEmptyString(entry.changedBy)
        && isNonEmptyString(entry.reason);
    }

    function validVersionedCreateEntries(data, hasConfidence) {
      return validLatestVersion(data)
        && validLatestStatus(data, data.status)
        && (!hasConfidence || validLatestConfidence(data, data.confidence));
    }

    // The subject write enforces the bounded history containers. The linked
    // immutable audit write validates the initial entries, which keeps each
    // operation below Firestore's per-operation expression budget.
    function validVersionedCreateStructure(data, hasConfidence) {
      return data.version == 1
        && data.versionHistory is map && data.versionHistory.size() == 1
        && data.statusHistory is map && data.statusHistory.size() == 1
        && (!hasConfidence
          || (data.confidenceHistory is map && data.confidenceHistory.size() == 1));
    }

    function validVersionedUpdate(data, hasConfidence) {
      return data.version == resource.data.version + 1
        && data.versionHistory is map
        && resource.data.versionHistory is map
        && data.versionHistory.size() == resource.data.versionHistory.size() + 1
        && mapHistoryPreserved(data.versionHistory, resource.data.versionHistory)
        && validLatestVersion(data)
        && data.get('legacyHistorySnapshot', null) == resource.data.get('legacyHistorySnapshot', null)
        && (data.status == resource.data.status
          ? (data.statusHistory == resource.data.statusHistory
            && data.latestStatusKey == resource.data.latestStatusKey)
          : (data.statusHistory is map
            && resource.data.statusHistory is map
            && data.statusHistory.size() == resource.data.statusHistory.size() + 1
            && mapHistoryPreserved(data.statusHistory, resource.data.statusHistory)
            && validLatestStatus(data, resource.data.status)))
        && (!hasConfidence || (data.confidence == resource.data.confidence
          ? (data.confidenceHistory == resource.data.confidenceHistory
            && data.latestConfidenceKey == resource.data.latestConfidenceKey)
          : (data.confidenceHistory is map
            && resource.data.confidenceHistory is map
            && data.confidenceHistory.size() == resource.data.confidenceHistory.size() + 1
            && mapHistoryPreserved(data.confidenceHistory, resource.data.confidenceHistory)
            && validLatestConfidence(data, resource.data.confidence))));
    }

    function isExplicitLegacyVersionedResource(hasConfidence) {
      return isExplicitLegacyVersionedData(resource.data, hasConfidence);
    }

    function isExplicitLegacyVersionedData(previous, hasConfidence) {
      let versionHistory = previous.get('versionHistory', null);
      let statusHistory = previous.get('statusHistory', null);
      let confidenceHistory = previous.get('confidenceHistory', null);
      return (versionHistory == null || versionHistory is list)
        && (statusHistory == null || statusHistory is list)
        && (!hasConfidence || confidenceHistory == null || confidenceHistory is list)
        && !previous.keys().hasAny(['latestVersionKey', 'latestStatusKey', 'legacyHistorySnapshot'])
        && (!hasConfidence || !previous.keys().hasAny(['latestConfidenceKey']));
    }

    function legacyHistorySnapshotPreservedAgainst(data, previous, historyField) {
      let previousHistory = previous.get(historyField, null);
      let nextSnapshot = data.get('legacyHistorySnapshot', {});
      let previousSnapshot = previous.get('legacyHistorySnapshot', {});
      return previousHistory is list
        ? nextSnapshot.get(historyField, null) == previousHistory
        : nextSnapshot.get(historyField, null) == previousSnapshot.get(historyField, null);
    }

    function legacyHistorySnapshotsPreservedAgainst(data, previous, hasConfidence) {
      return (!previous.keys().hasAny(['versionHistory', 'legacyHistorySnapshot'])
          || legacyHistorySnapshotPreservedAgainst(data, previous, 'versionHistory'))
        && (!previous.keys().hasAny(['statusHistory', 'legacyHistorySnapshot'])
          || legacyHistorySnapshotPreservedAgainst(data, previous, 'statusHistory'))
        && (!hasConfidence
          || (!previous.keys().hasAny(['confidenceHistory', 'legacyHistorySnapshot'])
            || legacyHistorySnapshotPreservedAgainst(data, previous, 'confidenceHistory')));
    }

    function validLegacyVersionedUpdateAgainst(data, previous, hasConfidence) {
      let previousHasVersion = previous.keys().hasAny(['version']);
      return isExplicitLegacyVersionedData(previous, hasConfidence)
        && (previousHasVersion ? data.version == previous.version + 1 : data.version >= 2)
        && data.versionHistory is map
        && data.versionHistory.size() == data.version
        && validLatestVersion(data)
        && data.statusHistory is map && data.statusHistory.size() >= 1
        && (data.status == previous.status
          ? validCurrentStatusPointer(data)
          : validLatestStatus(data, previous.status))
        && (!hasConfidence || (data.confidenceHistory is map
          && data.confidenceHistory.size() >= 1
          && (data.confidence == previous.confidence
            ? validCurrentConfidencePointer(data)
            : validLatestConfidence(data, previous.confidence))))
        && legacyHistorySnapshotsPreservedAgainst(data, previous, hasConfidence);
    }

    function validLegacyVersionedUpdateStructure(data, hasConfidence) {
      return data.version is int && data.version >= 2
        && data.versionHistory is map && data.versionHistory.size() == data.version
        && data.statusHistory is map && data.statusHistory.size() >= 1
        && (!hasConfidence
          || (data.confidenceHistory is map && data.confidenceHistory.size() >= 1))
        && data.get('legacyHistorySnapshot', {}) is map;
    }

    function validLegacyVersionedUpdate(data, hasConfidence) {
      return validLegacyVersionedUpdateAgainst(data, resource.data, hasConfidence);
    }

    function validVersionedMutation(data, hasConfidence) {
      let completeResourceHistory = resource.data.version is int
        && resource.data.versionHistory is map
        && resource.data.statusHistory is map
        && (!hasConfidence || resource.data.confidenceHistory is map);
      return (completeResourceHistory && validVersionedUpdate(data, hasConfidence))
        || (!completeResourceHistory
          && isExplicitLegacyVersionedResource(hasConfidence)
          && validLegacyVersionedUpdate(data, hasConfidence));
    }

    function auditEventPath(eventId) {
      return /databases/$(database)/documents/internalKnowledgeAuditEvents/$(eventId);
    }

    function hasMutationAudit(data, subjectType) {
      let expectedAuditId = 'knowledge-audit_' + subjectType + '_' + data.id + '_' + data.latestVersionKey;
      return data.lastAuditEventId is string
        && data.latestVersionKey is string
        && data.lastAuditEventId == expectedAuditId
        && existsAfter(auditEventPath(expectedAuditId));
    }

    function hasFullyBoundMutationAudit(data, subjectType) {
      let expectedAuditId = 'knowledge-audit_' + subjectType + '_' + data.id + '_' + data.latestVersionKey;
      let auditPath = auditEventPath(expectedAuditId);
      let audit = getAfter(auditPath).data;
      return hasMutationAudit(data, subjectType)
        && audit.id == expectedAuditId
        && audit.workspaceId == data.workspaceId
        && audit.subjectType == subjectType
        && audit.subjectId == data.id
        && audit.actorId == request.auth.uid
        && audit.occurredAt == request.time
        && audit.version == data.version;
    }

    function nodeRegistryPath(workspaceId, nodeType) {
      return /databases/$(database)/documents/internalKnowledgeUniqueness/$("node-registry:" + workspaceId + ":" + nodeType);
    }

    function relationshipRegistryPath(workspaceId) {
      return /databases/$(database)/documents/internalKnowledgeUniqueness/$("relationship-registry:" + workspaceId);
    }

    function sourceRegistryPath(workspaceId) {
      return /databases/$(database)/documents/internalKnowledgeUniqueness/$("source-registry:" + workspaceId);
    }

    function nodeRegistryOwnsAll(data, documentId) {
      let registry = getAfter(nodeRegistryPath(data.workspaceId, data.type)).data;
      let keys = data.canonicalNameKeys;
      return existsAfter(nodeRegistryPath(data.workspaceId, data.type))
        && keys.size() > 0 && keys.size() <= 4 && keys.toSet().size() == keys.size()
        && registry.kind == 'node-registry'
        && registry.workspaceId == data.workspaceId
        && registry.nodeType == data.type
        && registry.owners.get(keys[0], '') == documentId
        && (keys.size() <= 1 || registry.owners.get(keys[1], '') == documentId)
        && (keys.size() <= 2 || registry.owners.get(keys[2], '') == documentId)
        && (keys.size() <= 3 || registry.owners.get(keys[3], '') == documentId)
        && registry.claimedKeysByNode.get(documentId, []) == keys;
    }

    function sourcePath(sourceId) {
      return /databases/$(database)/documents/internalKnowledgeSources/$(sourceId);
    }

    function activeSourceRecord(sourceId, workspaceId) {
      let path = sourcePath(sourceId);
      let source = getAfter(path);
      return isIdentifier(sourceId)
        && existsAfter(path)
        && source.data.workspaceId == workspaceId
        && source.data.status == 'active';
    }

    function activeSourceAt(sourceIds, index, workspaceId) {
      return sourceIds.size() <= index
        || activeSourceRecord(sourceIds[index], workspaceId);
    }

    function canonicalSourcesValid(data) {
      return data.sourceIds is list
        && data.sourceIds.size() <= 4
        && data.sourceIds.toSet().size() == data.sourceIds.size()
        && activeSourceAt(data.sourceIds, 0, data.workspaceId)
        && activeSourceAt(data.sourceIds, 1, data.workspaceId)
        && activeSourceAt(data.sourceIds, 2, data.workspaceId)
        && activeSourceAt(data.sourceIds, 3, data.workspaceId)
        && (data.confidence != 'verified' || data.sourceIds.size() > 0)
        && (data.confidence != 'conflicting' || data.sourceIds.size() > 1);
    }

    function canonicalRelationshipSourcesValid(data) {
      return data.sourceIds is list
        && data.sourceIds.size() <= 2
        && data.sourceIds.toSet().size() == data.sourceIds.size()
        && activeSourceAt(data.sourceIds, 0, data.workspaceId)
        && activeSourceAt(data.sourceIds, 1, data.workspaceId)
        && data.sourceIds.size() > 0;
    }

    function sourceUsedAt(registry, sourceIds, index, subjectKey, shouldBeUsed) {
      return sourceIds.size() <= index
        || (shouldBeUsed && registry.subjectKeysBySource.get(sourceIds[index], []).hasAny([subjectKey]))
        || (!shouldBeUsed && !registry.subjectKeysBySource.get(sourceIds[index], []).hasAny([subjectKey]));
    }

    function sourceRegistryValidFor(data, subjectKey, shouldBeUsed) {
      let registry = getAfter(sourceRegistryPath(data.workspaceId)).data;
      return existsAfter(sourceRegistryPath(data.workspaceId))
        && registry.kind == 'source-registry'
        && registry.workspaceId == data.workspaceId
        && registry.activeSourceIds.hasAll(data.sourceIds)
        && sourceUsedAt(registry, data.sourceIds, 0, subjectKey, shouldBeUsed)
        && sourceUsedAt(registry, data.sourceIds, 1, subjectKey, shouldBeUsed)
        && sourceUsedAt(registry, data.sourceIds, 2, subjectKey, shouldBeUsed)
        && sourceUsedAt(registry, data.sourceIds, 3, subjectKey, shouldBeUsed);
    }

    function relationshipSourceRegistryValidFor(data, documentId, shouldBeUsed) {
      let registry = getAfter(sourceRegistryPath(data.workspaceId)).data;
      let subjectKey = 'relationship:' + documentId;
      return existsAfter(sourceRegistryPath(data.workspaceId))
        && registry.kind == 'source-registry'
        && registry.workspaceId == data.workspaceId
        && registry.activeSourceIds.hasAll(data.sourceIds)
        && sourceUsedAt(registry, data.sourceIds, 0, subjectKey, shouldBeUsed)
        && sourceUsedAt(registry, data.sourceIds, 1, subjectKey, shouldBeUsed);
    }

    function canonicalSourceIdsOnly(data) {
      return data.sources == [];
    }

    function relationshipRegistryValid(data, documentId, shouldBeActive) {
      let registry = getAfter(relationshipRegistryPath(data.workspaceId)).data;
      let exclusiveIds = registry.exclusiveActive.get(data.get('exclusiveClaimKey', ''), []);
      return existsAfter(relationshipRegistryPath(data.workspaceId))
        && registry.exactOwners.get(data.identityKey, '') == documentId
        && ((shouldBeActive
          && registry.endpointActive.get(data.fromNodeId, []).hasAny([documentId])
          && registry.endpointActive.get(data.toNodeId, []).hasAny([documentId]))
          || (!shouldBeActive
            && !registry.endpointActive.get(data.fromNodeId, []).hasAny([documentId])
            && !registry.endpointActive.get(data.toNodeId, []).hasAny([documentId])))
        && (!data.keys().hasAny(['exclusiveClaimKey'])
          || (((shouldBeActive && exclusiveIds.hasAny([documentId]))
              || (!shouldBeActive && !exclusiveIds.hasAny([documentId])))
            && (!shouldBeActive
              || (exclusiveIds.size() > 1
                ? data.confidence == 'conflicting'
                : data.confidence != 'conflicting'))));
    }

    function exclusiveConflictRegistryValid(data, documentId) {
      let registry = getAfter(relationshipRegistryPath(data.workspaceId)).data;
      let exclusiveIds = registry.exclusiveActive.get(data.exclusiveClaimKey, []);
      return existsAfter(relationshipRegistryPath(data.workspaceId))
        && exclusiveIds.size() > 1
        && exclusiveIds.hasAny([documentId]);
    }

    function validExclusiveConflictHistoryUpdate(data) {
      return data.version == resource.data.version + 1
        && data.versionHistory is map
        && resource.data.versionHistory is map
        && data.versionHistory.size() == resource.data.versionHistory.size() + 1
        && mapHistoryPreserved(data.versionHistory, resource.data.versionHistory)
        && validLatestVersion(data)
        && data.statusHistory == resource.data.statusHistory
        && data.latestStatusKey == resource.data.latestStatusKey
        && data.confidenceHistory is map
        && resource.data.confidenceHistory is map
        && data.confidenceHistory.size() == resource.data.confidenceHistory.size() + 1
        && mapHistoryPreserved(data.confidenceHistory, resource.data.confidenceHistory)
        && validLatestConfidence(data, resource.data.confidence);
    }

    function nodeHasNoActiveRelationships(data, documentId) {
      let registry = getAfter(relationshipRegistryPath(data.workspaceId)).data;
      return existsAfter(relationshipRegistryPath(data.workspaceId))
        && registry.kind == 'relationship-registry'
        && registry.workspaceId == data.workspaceId
        && registry.updatedBy == request.auth.uid
        && registry.updatedAt == request.time
        && registry.endpointActive.get(documentId, []).size() == 0;
    }

    function validRelationshipIdentity(data) {
      let reverse = relationshipUsesReverseCanonicalDirection(data.relationshipType);
      let canonicalFrom = reverse ? data.toNodeId : data.fromNodeId;
      let canonicalTo = reverse ? data.fromNodeId : data.toNodeId;
      let family = relationshipFamily(data.relationshipType);
      let exclusiveEndpoint = (family == 'school-coach' || family == 'school-facility')
        ? canonicalTo
        : canonicalFrom;
      return family != ''
        && data.identityKey == data.workspaceId + ':' + family + ':' + canonicalFrom + ':' + canonicalTo
        && (isExclusiveRelationshipType(data.relationshipType)
          ? (data.keys().hasAny(['exclusiveClaimKey'])
            && data.exclusiveClaimKey == data.workspaceId + ':' + family + ':exclusive:' + exclusiveEndpoint)
          : !data.keys().hasAny(['exclusiveClaimKey']));
    }

    function endpointTypesValid(relationship, fromType, toType) {
      return (fromType == 'school' && (
          (relationship.relationshipType == 'SCHOOL_LOCATED_IN_STATE' && toType == 'state')
          || (relationship.relationshipType == 'SCHOOL_LOCATED_IN_REGION' && toType == 'region')
          || (relationship.relationshipType == 'SCHOOL_BELONGS_TO_CONFERENCE' && toType == 'conference')
          || (relationship.relationshipType == 'SCHOOL_HAS_COACH' && toType == 'coach')
          || (relationship.relationshipType == 'SCHOOL_HAS_FACILITY' && toType == 'facility')
        ))
        || (toType == 'school' && (
          (relationship.relationshipType == 'PLAYER_CONNECTED_TO_SCHOOL' && fromType == 'player')
          || (relationship.relationshipType == 'FACILITY_BELONGS_TO_SCHOOL' && fromType == 'facility')
          || (relationship.relationshipType == 'COACH_WORKS_AT_SCHOOL' && fromType == 'coach')
          || (relationship.relationshipType == 'CONFERENCE_GOVERNS_SCHOOL' && fromType == 'conference')
          || (relationship.relationshipType == 'PROJECT_ABOUT_SCHOOL' && fromType == 'project')
          || (relationship.relationshipType == 'CONTENT_ABOUT_SCHOOL' && fromType == 'content')
        ));
    }

    function validRelationshipEndpoints(data, requireActive) {
      let fromPath = /databases/$(database)/documents/internalKnowledgeNodes/$(data.fromNodeId);
      let toPath = /databases/$(database)/documents/internalKnowledgeNodes/$(data.toNodeId);
      let fromNode = getAfter(fromPath);
      let toNode = getAfter(toPath);
      return data.fromNodeId != data.toNodeId
        && existsAfter(fromPath) && existsAfter(toPath)
        && fromNode.data.workspaceId == data.workspaceId
        && toNode.data.workspaceId == data.workspaceId
        && endpointTypesValid(data, fromNode.data.type, toNode.data.type)
        && (!requireActive || (fromNode.data.status == 'active' && toNode.data.status == 'active'));
    }

    function schoolRegionForState(value) {
      return value in ['ME', 'NH', 'VT', 'MA', 'RI', 'CT', 'NY', 'NJ',
          'Maine', 'New Hampshire', 'Vermont', 'Massachusetts', 'Rhode Island',
          'Connecticut', 'New York', 'New Jersey'] ? 'northeast'
        : value in ['DE', 'PA', 'DC', 'WV', 'VA', 'Delaware', 'Pennsylvania',
          'District of Columbia', 'West Virginia', 'Virginia'] ? 'mid_atlantic'
        : value in ['NC', 'SC', 'GA', 'TN', 'KY', 'North Carolina', 'South Carolina',
          'Georgia', 'Tennessee', 'Kentucky'] ? 'southeast'
        : value in ['AL', 'FL', 'MS', 'LA', 'Alabama', 'Florida', 'Mississippi', 'Louisiana']
          ? 'gulf_states'
        : value in ['OH', 'MI', 'IL', 'IN', 'WI', 'Ohio', 'Michigan', 'Illinois',
          'Indiana', 'Wisconsin'] ? 'greater_lakes'
        : value in ['AR', 'MO', 'IA', 'MN', 'OK', 'KS', 'NE', 'ND', 'SD', 'Arkansas',
          'Missouri', 'Iowa', 'Minnesota', 'Oklahoma', 'Kansas', 'Nebraska',
          'North Dakota', 'South Dakota'] ? 'midwest'
        : value in ['TX', 'CO', 'NM', 'Texas', 'Colorado', 'New Mexico'] ? 'texas'
        : value in ['AZ', 'UT', 'NV', 'CA', 'Arizona', 'Utah', 'Nevada', 'California']
          ? 'southwest'
        : value in ['WA', 'OR', 'ID', 'MT', 'WY', 'AK', 'HI', 'Washington', 'Oregon',
          'Idaho', 'Montana', 'Wyoming', 'Alaska', 'Hawaii'] ? 'northwest'
        : '';
    }

    function validOptionalNonNegativeNumber(data, field) {
      return !(field in data)
        || ((data[field] is int || data[field] is float) && data[field] >= 0);
    }

    function validSchoolTuition(data) {
      return !data.keys().hasAny(['tuition'])
        || (data.tuition is map
          && data.tuition.keys().hasAll(['currency'])
          && data.tuition.keys().hasOnly(['currency', 'inState', 'outOfState', 'academicYear'])
          && data.tuition.currency == 'USD'
          && validOptionalNonNegativeNumber(data.tuition, 'inState')
          && validOptionalNonNegativeNumber(data.tuition, 'outOfState')
          && (!data.tuition.keys().hasAny(['academicYear'])
            || isNonEmptyString(data.tuition.academicYear)));
    }

    function validNodeSubtype(data) {
      return data.type == 'project'
          ? isIdentifier(data.projectId)
          : (data.type == 'content'
            ? (isIdentifier(data.contentId) && optionalHttpUrl(data, 'contentUrl'))
            : true);
    }

    function validNodeVersionSnapshot(data) {
      let entry = data.versionHistory.get(data.latestVersionKey, {});
      return entry.confidence == data.confidence
        && entry.status == data.status
        && entry.sourceIds == data.sourceIds;
    }

    function validNodeBase(data, documentId) {
      return canonicalSourceIdsOnly(data)
        && data.id == documentId && isIdentifier(data.id) && isIdentifier(data.workspaceId)
        && isKnowledgeNodeType(data.type) && isNonEmptyString(data.name)
        && isKnowledgeConfidence(data.confidence) && isKnowledgeStatus(data.status)
        && data.version is int && data.version >= 1
        && validNodeVersionSnapshot(data);
    }

    function validNodeCreate(data, documentId) {
      return nodeRegistryOwnsAll(data, documentId)
        && hasMutationAudit(data, 'node')
        && canonicalSourcesValid(data)
        && sourceRegistryValidFor(data, 'node:' + documentId, true)
        && validVersionedCreateStructure(data, true)
        && data.status == 'active' && createAttribution(data)
        && !data.keys().hasAny(['legacyHistorySnapshot'])
        && validNodeBase(data, documentId) && validNodeSubtype(data);
    }

    function validNodeUpdate(data, documentId) {
      return validNodeBase(data, documentId)
        && data.workspaceId == resource.data.workspaceId
        && data.type == resource.data.type
        && resource.data.status == 'active' && (data.status == 'active' || data.status == 'archived')
        && updateAttribution(data) && validVersionedUpdate(data, true)
        && validNodeSubtype(data)
        && ((data.name == resource.data.name
            && data.aliases == resource.data.aliases
            && data.canonicalNameKeys == resource.data.canonicalNameKeys)
          || nodeRegistryOwnsAll(data, documentId))
        && (data.status == 'archived'
          || data.sourceIds == resource.data.sourceIds
          || canonicalSourcesValid(data))
        && sourceRegistryValidFor(data, 'node:' + documentId, data.status == 'active')
        && (data.status == 'active' || nodeHasNoActiveRelationships(data, documentId))
        && hasMutationAudit(data, 'node');
    }

    function validLegacyNodeUpdate(data, documentId) {
      return isExplicitLegacyVersionedResource(true)
        && canonicalSourceIdsOnly(data)
        && data.id == documentId
        && data.workspaceId == resource.data.workspaceId
        && data.type == resource.data.type
        && data.name == resource.data.name
        && data.aliases == resource.data.aliases
        && isKnowledgeConfidence(data.confidence)
        && resource.data.status == 'active'
        && (data.status == 'active' || data.status == 'archived')
        && data.sourceIds == resource.data.sourceIds
        && updateAttribution(data)
        && validLegacyVersionedUpdateStructure(data, true)
        && validNodeVersionSnapshot(data)
        && validNodeSubtype(data)
        && (data.status == 'archived' || canonicalSourcesValid(data))
        && sourceRegistryValidFor(data, 'node:' + documentId, data.status == 'active')
        && (data.status == 'active' || nodeHasNoActiveRelationships(data, documentId))
        && hasFullyBoundMutationAudit(data, 'node');
    }

    function validRelationshipBase(data, documentId) {
      return canonicalSourceIdsOnly(data)
        && data.id == documentId
        && isKnowledgeConfidence(data.confidence)
        && data.projectIds is list && data.projectIds.size() <= 64;
    }

    function validRelationshipUpdateBase(data, documentId) {
      return canonicalSourceIdsOnly(data)
        && data.id == documentId && data.id == resource.data.id
        && data.workspaceId == resource.data.workspaceId
        && data.fromNodeId == resource.data.fromNodeId
        && data.toNodeId == resource.data.toNodeId
        && data.relationshipType == resource.data.relationshipType
        && data.identityKey == resource.data.identityKey
        && data.get('exclusiveClaimKey', null) == resource.data.get('exclusiveClaimKey', null)
        && (data.confidence == resource.data.confidence || isKnowledgeConfidence(data.confidence))
        && (data.projectIds == resource.data.projectIds
          || (data.projectIds is list && data.projectIds.size() <= 64))
        && data.version is int && data.version > 0;
    }

    function validRelationshipVersionSnapshot(data) {
      let entry = data.versionHistory.get(data.latestVersionKey, {});
      return entry.confidence == data.confidence && entry.status == data.status
        && entry.sourceIds == data.sourceIds && entry.projectIds == data.projectIds;
    }

    function validRelationshipCreate(data, documentId) {
      return validRelationshipBase(data, documentId) && data.status == 'active'
        && validRelationshipIdentity(data)
        && createAttribution(data)
        && canonicalRelationshipSourcesValid(data)
        && relationshipSourceRegistryValidFor(data, documentId, true)
        && (data.confidence != 'conflicting' || data.keys().hasAny(['exclusiveClaimKey']))
        && validVersionedCreateStructure(data, true)
        && validRelationshipVersionSnapshot(data)
        && validRelationshipEndpoints(data, true)
        && relationshipRegistryValid(data, documentId, true)
        && !data.keys().hasAny(['legacyHistorySnapshot'])
        && hasMutationAudit(data, 'relationship');
    }

    function validLegacyRelationshipUpdate(data, documentId) {
      return isExplicitLegacyVersionedResource(true)
        && canonicalSourceIdsOnly(data)
        && data.id == documentId && data.id == resource.data.id
        && data.workspaceId == resource.data.workspaceId
        && data.fromNodeId == resource.data.fromNodeId && data.toNodeId == resource.data.toNodeId
        && data.relationshipType == resource.data.relationshipType
        && validRelationshipIdentity(data)
        && resource.data.status == 'active'
        && (data.status == 'active' || data.status == 'archived')
        && isKnowledgeConfidence(data.confidence)
        && data.confidence == resource.data.confidence
        && data.sourceIds == resource.data.sourceIds
        && data.projectIds == resource.data.projectIds
        && updateAttribution(data)
        && validLegacyVersionedUpdateStructure(data, true)
        && validRelationshipVersionSnapshot(data)
        && relationshipSourceRegistryValidFor(data, documentId, data.status == 'active')
        && relationshipRegistryValid(data, documentId, data.status == 'active')
        && hasFullyBoundMutationAudit(data, 'relationship');
    }

    function validExclusiveConflictUpdate(data, documentId) {
      let changedFields = data.diff(resource.data).affectedKeys();
      return changedFields.hasOnly([
          'confidence', 'confidenceHistory', 'latestConfidenceKey',
          'version', 'versionHistory', 'latestVersionKey',
          'updatedBy', 'updatedAt', 'lastAuditEventId'
        ])
        && data.id == documentId
        && resource.data.keys().hasAny(['exclusiveClaimKey'])
        && data.confidence == 'conflicting'
        && resource.data.confidence != 'conflicting'
        && resource.data.status == 'active' && data.status == 'active'
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time
        && validExclusiveConflictHistoryUpdate(data)
        && validRelationshipVersionSnapshot(data)
        && exclusiveConflictRegistryValid(data, documentId)
        && hasMutationAudit(data, 'relationship');
    }

    function validExclusiveRelationshipUpdate(data, documentId) {
      return isExclusiveRelationshipType(resource.data.relationshipType)
        && validRelationshipUpdateBase(data, documentId)
        && resource.data.status == 'active'
        && (data.status == 'active' || data.status == 'archived')
        && data.confidence == resource.data.confidence
        && data.sourceIds == resource.data.sourceIds
        && data.projectIds == resource.data.projectIds
        && updateAttribution(data)
        && validVersionedUpdate(data, true)
        && validRelationshipVersionSnapshot(data)
        && relationshipRegistryValid(data, documentId, data.status == 'active')
        && relationshipSourceRegistryValidFor(data, documentId, data.status == 'active')
        && hasMutationAudit(data, 'relationship');
    }

    function validRelationshipUpdate(data, documentId) {
      return validRelationshipUpdateBase(data, documentId)
        && resource.data.status == 'active' && (data.status == 'active' || data.status == 'archived')
        && data.sourceIds.size() > 0 && updateAttribution(data)
        && validVersionedUpdate(data, true)
        && validRelationshipVersionSnapshot(data)
        && (data.status == 'archived'
          || data.sourceIds == resource.data.sourceIds
          || canonicalRelationshipSourcesValid(data))
        && relationshipSourceRegistryValidFor(data, documentId, data.status == 'active')
        && relationshipRegistryValid(data, documentId, data.status == 'active')
        && (!resource.data.keys().hasAny(['lastAuditEventId'])
          || data.lastAuditEventId != resource.data.lastAuditEventId)
        && hasMutationAudit(data, 'relationship');
    }

    function validSourceBase(data, documentId) {
      return data.keys().hasOnly([
          'id', 'workspaceId', 'title', 'url', 'publisher', 'sourceType', 'accessedAt',
          'publishedAt', 'reliability', 'notes', 'projectIds', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy', 'status', 'version', 'versionHistory', 'statusHistory',
          'lastAuditEventId', 'latestVersionKey', 'latestStatusKey',
          'legacyHistorySnapshot'
        ])
        && data.id == documentId && isIdentifier(data.id) && isIdentifier(data.workspaceId)
        && isNonEmptyString(data.title) && isSourceType(data.sourceType)
        && (data.accessedAt is string || data.accessedAt is timestamp)
        && isSourceReliability(data.reliability) && validStringList(data.projectIds, 64)
        && isKnowledgeStatus(data.status) && data.version is int && data.version >= 1
        && (!data.keys().hasAny(['legacyHistorySnapshot'])
          || data.legacyHistorySnapshot is map);
    }

    function validSourceVersionSnapshot(data) {
      let entry = data.versionHistory.get(data.latestVersionKey, {});
      return entry is map
        && entry.title == data.title && entry.get('url', null) == data.get('url', null)
        && entry.get('publisher', null) == data.get('publisher', null)
        && entry.sourceType == data.sourceType && entry.accessedAt == data.accessedAt
        && entry.get('publishedAt', null) == data.get('publishedAt', null)
        && entry.reliability == data.reliability && entry.get('notes', null) == data.get('notes', null)
        && entry.projectIds == data.projectIds && entry.status == data.status;
    }

    function sourceRegistryValidForSource(data, documentId, shouldBeActive) {
      let registry = getAfter(sourceRegistryPath(data.workspaceId)).data;
      return existsAfter(sourceRegistryPath(data.workspaceId))
        && registry.kind == 'source-registry' && registry.workspaceId == data.workspaceId
        && registry.updatedBy == request.auth.uid && registry.updatedAt == request.time
        && ((shouldBeActive && registry.activeSourceIds.hasAny([documentId]))
          || (!shouldBeActive && !registry.activeSourceIds.hasAny([documentId])
            && registry.subjectKeysBySource.get(documentId, []).size() == 0));
    }

    function auditSubjectCollection(subjectType) {
      return {
        'node': 'internalKnowledgeNodes',
        'relationship': 'internalKnowledgeRelationships',
        'source': 'internalKnowledgeSources'
      }.get(subjectType, '');
    }

    function auditSubjectVersioningValid(data, subjectPath, subject) {
      let hasConfidence = data.subjectType != 'source';
      return data.version == 1
        ? validVersionedCreateEntries(subject, hasConfidence)
        : (data.subjectType == 'source'
          || (exists(subjectPath)
            && (!isExplicitLegacyVersionedData(get(subjectPath).data, hasConfidence)
              || validLegacyVersionedUpdateAgainst(
                subject,
                get(subjectPath).data,
                hasConfidence
              ))));
    }

    function auditSubjectValid(data, documentId) {
      let collectionName = auditSubjectCollection(data.subjectType);
      let subjectPath = /databases/$(database)/documents/$(collectionName)/$(data.subjectId);
      let subject = getAfter(subjectPath).data;
      return collectionName != '' && existsAfter(subjectPath)
        && subject.lastAuditEventId == documentId
        && subject.workspaceId == data.workspaceId
        && subject.updatedBy == data.actorId
        && subject.version == data.version
        && auditSubjectVersioningValid(data, subjectPath, subject);
    }

    function isKnowledgeAuditEventType(value) {
      return value in [
        'created', 'updated', 'archived', 'confidence-changed', 'conflict-detected'
      ];
    }

    function validAuditMetadata(metadata) {
      return metadata is map
        && metadata.keys().hasOnly([
          'confidence', 'conflictCount', 'conflictingRelationshipId'
        ])
        && (!metadata.keys().hasAny(['confidence'])
          || isKnowledgeConfidence(metadata.confidence))
        && (!metadata.keys().hasAny(['conflictCount'])
          || (metadata.conflictCount is int
            && metadata.conflictCount >= 0 && metadata.conflictCount <= 1000))
        && (!metadata.keys().hasAny(['conflictingRelationshipId'])
          || isIdentifier(metadata.conflictingRelationshipId));
    }

    function validAuditEvent(data, documentId) {
      return data.keys().hasOnly([
          'id', 'workspaceId', 'subjectType', 'subjectId', 'eventType', 'actorId',
          'occurredAt', 'summary', 'version', 'metadata'
        ])
        && data.id == documentId
        && isIdentifier(data.workspaceId) && isIdentifier(data.subjectId)
        && isKnowledgeAuditEventType(data.eventType)
        && data.actorId == request.auth.uid
        && data.occurredAt == request.time
        && isNonEmptyString(data.summary)
        && data.version is int && data.version > 0
        && validAuditMetadata(data.metadata)
        && auditSubjectValid(data, documentId);
    }

    function validClaimBase(data, documentId) {
      return data.id == documentId && isNonEmptyString(data.id) && isIdentifier(data.workspaceId)
        && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validUniquenessClaim(data, documentId) {
      return validClaimBase(data, documentId)
        && data.kind in [
          'node-registry', 'relationship-registry', 'source-registry'
        ];
    }

    function permanentNodeClaimsPreserved(nextData) {
      let changes = nextData.owners.diff(resource.data.owners);
      return changes.removedKeys().size() == 0 && changes.changedKeys().size() == 0;
    }

    function permanentRelationshipClaimsPreserved(nextData) {
      let changes = nextData.exactOwners.diff(resource.data.exactOwners);
      return changes.removedKeys().size() == 0 && changes.changedKeys().size() == 0;
    }

    function permanentClaimsPreserved(nextData) {
      return resource.data.kind == 'node-registry'
        ? permanentNodeClaimsPreserved(nextData)
        : (resource.data.kind == 'relationship-registry'
          ? permanentRelationshipClaimsPreserved(nextData)
          : true);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /internalKnowledgeNodes/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validNodeCreate(request.resource.data, documentId);
      allow update: if isAdmin() && (
        validLegacyNodeUpdate(request.resource.data, documentId)
        || validNodeUpdate(request.resource.data, documentId)
      );
      allow delete: if false;
    }

    match /internalKnowledgeRelationships/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validRelationshipCreate(request.resource.data, documentId);
      allow update: if isAdmin() && (
        validLegacyRelationshipUpdate(request.resource.data, documentId)
        || validExclusiveConflictUpdate(request.resource.data, documentId)
        || validExclusiveRelationshipUpdate(request.resource.data, documentId)
        || validRelationshipUpdate(request.resource.data, documentId)
      );
      allow delete: if false;
    }

    match /internalKnowledgeSources/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validSourceBase(request.resource.data, documentId)
        && request.resource.data.status == 'active' && createAttribution(request.resource.data)
        && validVersionedCreateStructure(request.resource.data, false)
        && validSourceVersionSnapshot(request.resource.data)
        && sourceRegistryValidForSource(request.resource.data, documentId, true)
        && !request.resource.data.keys().hasAny(['legacyHistorySnapshot'])
        && hasFullyBoundMutationAudit(request.resource.data, 'source');
      allow update: if isAdmin() && validSourceBase(request.resource.data, documentId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.workspaceId == resource.data.workspaceId
        && resource.data.status == 'active'
        && (request.resource.data.status == 'active' || request.resource.data.status == 'archived')
        && updateAttribution(request.resource.data)
        && validVersionedMutation(request.resource.data, false)
        && validSourceVersionSnapshot(request.resource.data)
        && sourceRegistryValidForSource(request.resource.data, documentId, request.resource.data.status == 'active')
        && (!resource.data.keys().hasAny(['lastAuditEventId'])
          || request.resource.data.lastAuditEventId != resource.data.lastAuditEventId)
        && hasFullyBoundMutationAudit(request.resource.data, 'source');
      allow delete: if false;
    }

    match /internalKnowledgeAuditEvents/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAuditEvent(request.resource.data, documentId);
      allow update, delete: if false;
    }

    match /internalKnowledgeUniqueness/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validUniquenessClaim(request.resource.data, documentId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && request.resource.data.id == documentId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.kind in ['node-registry', 'relationship-registry', 'source-registry']
        && permanentClaimsPreserved(request.resource.data);
      allow delete: if false;
    }

    function validFounderSchoolDraft(data) {
      return data is map
        && data.keys().size() == 3
          + (data.keys().hasAny(['schoolWebsite']) ? 1 : 0)
          + (data.keys().hasAny(['athleticsWebsite']) ? 1 : 0)
          + (data.keys().hasAny(['governingBody']) ? 1 : 0)
          + (data.keys().hasAny(['division']) ? 1 : 0)
        && boundedString(data.officialName, 4096)
        && boundedString(data.city, 4096)
        && boundedString(data.state, 4096)
        && optionalString(data, 'schoolWebsite')
        && optionalString(data, 'athleticsWebsite')
        && optionalString(data, 'governingBody')
        && optionalString(data, 'division');
    }

    function validSpotlightPlatforms(values) {
      return validStringList(values, 3)
        && values.hasOnly(['instagram-reel', 'tiktok', 'youtube-short']);
    }

    function validSpotlightGoals(values) {
      return validStringList(values, 10)
        && values.hasOnly([
          'introduce-school', 'showcase-facilities', 'explain-basketball-program',
          'highlight-student-athlete-experience', 'help-recruits-evaluate',
          'correct-misconception', 'promote-specific-strength',
          'tell-unique-school-story', 'increase-awareness', 'other'
        ]);
    }

    function validSpotlightAudiences(values) {
      return validStringList(values, 9)
        && values.hasOnly([
          'players', 'parents-and-families', 'high-school-coaches',
          'college-coaches', 'recruits', 'current-students', 'alumni',
          'basketball-fans', 'other'
        ]);
    }

    function validSpotlightMedia(values) {
      return validStringList(values, 10)
        && values.hasOnly([
          'school-provided-photos', 'campus-photos', 'facility-photos',
          'game-footage', 'practice-footage', 'player-photos', 'coach-photos',
          'logos', 'no-media-yet', 'other'
        ]);
    }

    function validFounderRequest(data) {
      return data is map
        && data.keys().hasOnly([
          'objective', 'goals', 'goalOther', 'supplementalGoalText',
          'audience', 'audiences', 'audienceOther', 'platforms',
          'centralEmphasis', 'primaryEmphasis', 'emphasisOther',
          'specificAngle', 'availableMedia', 'media', 'mediaOther',
          'mediaDescription', 'needShotList', 'callToAction'
        ])
        && data.keys().size() == 10
          + (data.keys().hasAny(['goalOther']) ? 1 : 0)
          + (data.keys().hasAny(['supplementalGoalText']) ? 1 : 0)
          + (data.keys().hasAny(['audienceOther']) ? 1 : 0)
          + (data.keys().hasAny(['primaryEmphasis']) ? 1 : 0)
          + (data.keys().hasAny(['emphasisOther']) ? 1 : 0)
          + (data.keys().hasAny(['specificAngle']) ? 1 : 0)
          + (data.keys().hasAny(['mediaOther']) ? 1 : 0)
          + (data.keys().hasAny(['mediaDescription']) ? 1 : 0)
        && data.media is list
        && (!('no-media-yet' in data.media)
          || data.media.size() == 1)
        && boundedString(data.objective, 4096)
        && boundedString(data.audience, 4096)
        && boundedString(data.centralEmphasis, 4096)
        && boundedString(data.callToAction, 4096)
        && optionalString(data, 'goalOther')
        && optionalString(data, 'supplementalGoalText')
        && optionalString(data, 'audienceOther')
        && optionalString(data, 'emphasisOther')
        && optionalString(data, 'specificAngle')
        && optionalString(data, 'mediaOther')
        && optionalString(data, 'mediaDescription')
        && validSpotlightPlatforms(data.platforms)
        && validSpotlightGoals(data.goals)
        && validSpotlightAudiences(data.audiences)
        && (!data.keys().hasAny(['primaryEmphasis'])
          || data.primaryEmphasis in [
            'facilities', 'basketball-program', 'coaching-staff',
            'academic-opportunities', 'campus-experience', 'location',
            'recruiting-opportunity', 'player-development', 'affordability',
            'school-culture', 'other'
          ])
        && validSpotlightMedia(data.media)
        && data.needShotList is bool
        && validStringList(data.availableMedia, 16);
    }

    function validFounderCustomization(data) {
      return data is map
        && data.keys().hasOnly([
          'tone', 'length', 'hook', 'emphasis', 'callToAction',
          'mediaAvailability', 'brandingPreset', 'verticalVideoScript',
          'instagramCaption', 'shotList', 'rightsConfirmed'
        ])
        && data.keys().size() == 11
        && data.tone in ['clear-and-confident', 'energetic', 'community-focused']
        && data.length in ['short', 'standard', 'extended']
        && data.brandingPreset in ['headquarters', 'school-first', 'community-story']
        && boundedString(data.hook, 4096)
        && boundedString(data.emphasis, 4096)
        && boundedString(data.callToAction, 4096)
        && boundedString(data.verticalVideoScript, 20000)
        && boundedString(data.instagramCaption, 10000)
        && validStringList(data.mediaAvailability, 16)
        && validStringList(data.shotList, 32)
        && data.rightsConfirmed is bool;
    }

    function spotlightRequestMatches(left, right) {
      return left == right;
    }

    function spotlightCustomizationMatches(left, right) {
      return left == right;
    }

    function isSchoolSpotlightPackage(data) {
      return data.keys().hasAny(['packageKind'])
        && data.packageKind == 'school-spotlight';
    }

    function validSpotlightEvidenceShape(data) {
      return data is map
        && data.keys().hasOnly([
          'sourceId', 'sourceVersion', 'title', 'publisher', 'reliability', 'accessedAt'
        ])
        && data.keys().size() == 5
          + (data.keys().hasAny(['publisher']) ? 1 : 0)
        && isIdentifier(data.sourceId)
        && data.sourceVersion is int && data.sourceVersion > 0
        && boundedString(data.title, 4096) && data.title.size() > 0
        && optionalString(data, 'publisher')
        && isSourceReliability(data.reliability)
        && boundedString(data.accessedAt, 64) && data.accessedAt.size() > 0;
    }

    function validSpotlightEvidenceAt(values, index) {
      return values.size() <= index || validSpotlightEvidenceShape(values[index]);
    }

    function validSpotlightEvidenceList(values) {
      return values is list && values.size() <= 2
        && validSpotlightEvidenceAt(values, 0)
        && validSpotlightEvidenceAt(values, 1);
    }

    function spotlightEvidenceMatchesSource(data, workspaceId) {
      let sourcePath = /databases/$(database)/documents/internalKnowledgeSources/$(data.sourceId);
      let source = getAfter(sourcePath).data;
      return existsAfter(sourcePath)
        && source.id == data.sourceId
        && source.workspaceId == workspaceId
        && source.status == 'active'
        && source.version == data.sourceVersion;
    }

    function spotlightEvidenceLinkedAt(values, index, workspaceId) {
      return values.size() <= index || spotlightEvidenceMatchesSource(values[index], workspaceId);
    }

    function validSpotlightEvidenceLinkage(values, workspaceId) {
      return spotlightEvidenceLinkedAt(values, 0, workspaceId)
        && spotlightEvidenceLinkedAt(values, 1, workspaceId);
    }

    function validSpotlightFactShape(data, verificationSourceIds) {
      return data is map
        && data.keys().hasOnly([
          'id', 'category', 'label', 'value', 'status',
          'founderAuthored', 'sourceIds', 'position'
        ])
        && data.keys().size() == 8
        && data.id is string && data.id.size() > 0
        && data.category is string && data.category.size() > 0
        && data.label is string && data.label.size() > 0
        && data.value is string && data.value.size() > 0
        && data.status in [
          'verified', 'supported', 'needs-confirmation', 'conflicting', 'not-available'
        ]
        && data.founderAuthored is bool
        && validStringList(data.sourceIds, 2)
        && data.sourceIds.hasOnly(verificationSourceIds)
        && data.position is int && data.position >= 0 && data.position <= 64;
    }

    function validSpotlightFactAt(values, verificationSourceIds, index) {
      return values.size() <= index || validSpotlightFactShape(values[index], verificationSourceIds);
    }

    function validSpotlightScene(data) {
      return data is map
        && data.keys().hasOnly(['id', 'heading', 'narration', 'visualDirection'])
        && data.keys().size() == 4
        && data.id is string
        && data.heading is string
        && data.narration is string
        && data.visualDirection is string;
    }

    function validSpotlightSceneAt(values, index) {
      return values.size() <= index || validSpotlightScene(values[index]);
    }

    function validSpotlightSceneList(values) {
      return values is list && values.size() >= 2 && values.size() <= 10
        && validSpotlightSceneAt(values, 0)
        && validSpotlightSceneAt(values, 1)
        && validSpotlightSceneAt(values, 2)
        && validSpotlightSceneAt(values, 3)
        && validSpotlightSceneAt(values, 4)
        && validSpotlightSceneAt(values, 5)
        && validSpotlightSceneAt(values, 6)
        && validSpotlightSceneAt(values, 7)
        && validSpotlightSceneAt(values, 8)
        && validSpotlightSceneAt(values, 9);
    }

    function validSpotlightChecklists(data) {
      return data.productionChecklist == [
          {
            'id': 'spotlight-production-1',
            'label': 'Selected facts are represented in the package',
            'required': true,
            'completed': true
          },
          {
            'id': 'spotlight-production-2',
            'label': 'Vertical-video structure and Instagram caption are complete',
            'required': true,
            'completed': true
          }
        ]
        && data.mediaChecklist == [
          {
            'id': 'spotlight-media-1',
            'label': 'Photo and video shot list is complete',
            'required': true,
            'completed': true
          }
        ]
        && data.graphicsNeeded == [
          {
            'id': 'spotlight-graphics-1',
            'label': 'Hoop Frens brand treatment is selected',
            'required': true,
            'completed': true
          }
        ]
        && data.publishingRequirements == [
          {
            'id': 'spotlight-rights-confirmed',
            'label': 'Media rights are confirmed',
            'required': true,
            'completed': data.rightsConfirmed
          }
        ]
        && data.qaChecklist == [
          {
            'id': 'spotlight-qa-1',
            'label': 'Unsupported facts remain excluded or explicitly Founder-authored',
            'required': true,
            'completed': true
          },
          {
            'id': 'spotlight-qa-2',
            'label': 'Source and verification package is attached',
            'required': true,
            'completed': true
          }
        ];
    }

    function validSpotlightTextAt(values, index) {
      return values.size() <= index || boundedString(values[index], 20000);
    }

    function validSpotlightTextList(values, maximumSize) {
      return values is list && values.size() <= maximumSize
        && validSpotlightTextAt(values, 0)
        && validSpotlightTextAt(values, 1)
        && validSpotlightTextAt(values, 2)
        && validSpotlightTextAt(values, 3)
        && (maximumSize <= 4 || validSpotlightTextAt(values, 4))
        && (maximumSize <= 5 || validSpotlightTextAt(values, 5))
        && (maximumSize <= 6 || validSpotlightTextAt(values, 6))
        && (maximumSize <= 7 || validSpotlightTextAt(values, 7));
    }

    function spotlightFactsIntegrityPath(packageId) {
      return /databases/$(database)/documents/internalSchoolSpotlightPackageFacts/$(packageId);
    }

    function spotlightContentIntegrityPath(packageId) {
      return /databases/$(database)/documents/internalSchoolSpotlightPackageContent/$(packageId);
    }

    function spotlightDeliveryIntegrityPath(packageId) {
      return /databases/$(database)/documents/internalSchoolSpotlightPackageDelivery/$(packageId);
    }

    function spotlightFactPartIntegrityPath(packageId, part) {
      return part == 1
        ? /databases/$(database)/documents/internalSchoolSpotlightPackageFactsA/$(packageId + '-1')
        : /databases/$(database)/documents/internalSchoolSpotlightPackageFactsB/$(packageId + '-2');
    }

    function spotlightRequestIntegrityPath(packageId) {
      return /databases/$(database)/documents/internalSchoolSpotlightPackageRequest/$(packageId);
    }

    function spotlightCustomizationIntegrityPath(packageId) {
      return /databases/$(database)/documents/internalSchoolSpotlightPackageCustomization/$(packageId);
    }

    function validSpotlightFactsIntegrity(data, documentId) {
      return data is map
        && data.keys().hasOnly([
          'packageId', 'workspaceId', 'ownerId', 'selectedFactCount',
          'selectedFactIds', 'selectedFactPositions',
          'verificationSourceIds', 'verificationSources'
        ])
        && data.packageId == documentId
        && isIdentifier(data.workspaceId)
        && data.ownerId == request.auth.uid
        && data.selectedFactCount is int
        && data.selectedFactCount > 0 && data.selectedFactCount <= 8
        && validStringList(data.selectedFactIds, 8)
        && data.selectedFactIds.size() == data.selectedFactCount
        // Fact-part documents validate each position as an integer; here we only
        // enforce the canonical count and uniqueness to avoid repeated evaluation
        // for the maximum eight-fact request.
        && data.selectedFactPositions is list
        && data.selectedFactPositions.size() == data.selectedFactCount
        && data.selectedFactPositions.size() <= 8
        && validSpotlightEvidenceList(data.verificationSources)
        && validSpotlightEvidenceLinkage(data.verificationSources, data.workspaceId)
        && validStringList(data.verificationSourceIds, 2)
        && data.verificationSourceIds.size() == data.verificationSources.size()
        && spotlightEvidenceIdsMatch(data.verificationSources, data.verificationSourceIds, 0)
        && spotlightEvidenceIdsMatch(data.verificationSources, data.verificationSourceIds, 1);
    }

    function spotlightEvidenceIdsMatch(sources, sourceIds, index) {
      return sources.size() <= index || sourceIds[index] == sources[index].sourceId;
    }

    function validSpotlightPositionAt(values, index) {
      return values.size() <= index
        || (values[index] is int && values[index] >= 0 && values[index] <= 64);
    }

    function validSpotlightPositionList(values, expectedSize) {
      return values is list
        && values.size() == expectedSize
        && values.toSet().size() == expectedSize
        && validSpotlightPositionAt(values, 0)
        && validSpotlightPositionAt(values, 1)
        && validSpotlightPositionAt(values, 2)
        && validSpotlightPositionAt(values, 3)
        && validSpotlightPositionAt(values, 4)
        && validSpotlightPositionAt(values, 5)
        && validSpotlightPositionAt(values, 6)
        && validSpotlightPositionAt(values, 7);
    }

    function validSpotlightFactPartEntry(data, facts, localIndex, canonicalIndex) {
      return data.selectedFacts.size() <= localIndex
        || (data.selectedFacts[localIndex].id == facts.selectedFactIds[canonicalIndex]
          && data.selectedFacts[localIndex].position == facts.selectedFactPositions[canonicalIndex]);
    }

    function validSpotlightFactPartList(values, verificationSourceIds) {
      return values is list && values.size() <= 4
        && validSpotlightFactAt(values, verificationSourceIds, 0)
        && validSpotlightFactAt(values, verificationSourceIds, 1)
        && validSpotlightFactAt(values, verificationSourceIds, 2)
        && validSpotlightFactAt(values, verificationSourceIds, 3);
    }

    function validSpotlightFactPartIntegrity(data, documentId) {
      let factsPath = spotlightFactsIntegrityPath(data.packageId);
      let facts = get(factsPath).data;
      let expectedSize = data.part == 1
        ? (facts.selectedFactCount > 4 ? 4 : facts.selectedFactCount)
        : (facts.selectedFactCount > 4 ? facts.selectedFactCount - 4 : 0);
      let offset = data.part == 1 ? 0 : 4;
      return data is map
        && data.keys().hasOnly([
          'packageId', 'workspaceId', 'ownerId', 'part', 'selectedFacts'
        ])
        && data.part in [1, 2]
        && ((data.part == 1 && documentId == data.packageId + '-1')
          || (data.part == 2 && documentId == data.packageId + '-2'))
        && exists(factsPath)
        && data.workspaceId == facts.workspaceId
        && data.ownerId == request.auth.uid
        && data.ownerId == facts.ownerId
        && validSpotlightFactPartList(data.selectedFacts, facts.verificationSourceIds)
        && data.selectedFacts.size() == expectedSize
        && validSpotlightFactPartEntry(data, facts, 0, offset)
        && validSpotlightFactPartEntry(data, facts, 1, offset + 1)
        && validSpotlightFactPartEntry(data, facts, 2, offset + 2)
        && validSpotlightFactPartEntry(data, facts, 3, offset + 3);
    }

    function validSpotlightContentIntegrity(data, documentId) {
      return data is map
        && data.keys().hasOnly([
          'packageId', 'workspaceId', 'ownerId', 'workflowDraftId',
          'workingDraft', 'verticalVideo', 'instagramCaption', 'shotList'
        ])
        && data.packageId == documentId
        && isIdentifier(data.workspaceId)
        && data.ownerId == request.auth.uid
        && isIdentifier(data.workflowDraftId)
        && boundedString(data.workingDraft, 40000) && data.workingDraft.size() > 0
        && data.verticalVideo is map
        && data.verticalVideo.keys().size() == 4
        && boundedString(data.verticalVideo.title, 10000) && data.verticalVideo.title.size() > 0
        && boundedString(data.verticalVideo.hook, 20000) && data.verticalVideo.hook.size() > 0
        && boundedString(data.verticalVideo.callToAction, 20000) && data.verticalVideo.callToAction.size() > 0
        && validSpotlightSceneList(data.verticalVideo.scenes)
        && boundedString(data.instagramCaption, 10000) && data.instagramCaption.size() > 0
        && validSpotlightTextList(data.shotList, 4);
    }

    function validSpotlightDeliveryIntegrity(data, documentId) {
      return data is map
        && data.keys().hasOnly([
          'packageId', 'workspaceId', 'ownerId', 'workflowDraftId',
          'excludedFactIds', 'unresolvedWarnings', 'rightsConfirmed',
          'productionChecklist', 'mediaChecklist', 'graphicsNeeded',
          'publishingRequirements', 'qaChecklist'
        ])
        && data.packageId == documentId
        && isIdentifier(data.workspaceId)
        && data.ownerId == request.auth.uid
        && isIdentifier(data.workflowDraftId)
        && validSpotlightTextList(data.excludedFactIds, 8)
        && validSpotlightTextList(data.unresolvedWarnings, 8)
        && data.rightsConfirmed is bool
        && validSpotlightChecklists(data);
    }

    function validSpotlightRequestIntegrity(data, documentId) {
      let draftPath = /databases/$(database)/documents/internalFounderWorkflowDrafts/$(data.workflowDraftId);
      let draft = get(draftPath).data;
      return data is map
        && data.keys().hasOnly([
          'packageId', 'workspaceId', 'ownerId', 'workflowDraftId', 'request'
        ])
        && data.packageId == documentId
        && isIdentifier(data.workspaceId)
        && data.ownerId == request.auth.uid
        && isIdentifier(data.workflowDraftId)
        && validFounderRequest(data.request)
        && exists(draftPath)
        && draft.workspaceId == data.workspaceId
        && draft.ownerId == data.ownerId
        && draft.status == 'active'
        && draft.request == data.request;
    }

    function validSpotlightCustomizationIntegrity(data, documentId) {
      let draftPath = /databases/$(database)/documents/internalFounderWorkflowDrafts/$(data.workflowDraftId);
      let draft = get(draftPath).data;
      return data is map
        && data.keys().hasOnly([
          'packageId', 'workspaceId', 'ownerId', 'workflowDraftId', 'customization'
        ])
        && data.packageId == documentId
        && isIdentifier(data.workspaceId)
        && data.ownerId == request.auth.uid
        && isIdentifier(data.workflowDraftId)
        && validFounderCustomization(data.customization)
        && exists(draftPath)
        && draft.workspaceId == data.workspaceId
        && draft.ownerId == data.ownerId
        && draft.status == 'active'
        && draft.customization == data.customization;
    }

    function validSchoolSpotlightPackageIntegrity(data, documentId) {
      // Each integrity document validates its complete nested schema on write. The
      // package header only needs a bounded set of cross-document links here. This
      // keeps the maximum supported eight-fact package below Firestore's expression
      // ceiling while retaining atomic linkage checks at the package boundary.
      let facts = getAfter(spotlightFactsIntegrityPath(documentId));
      let content = getAfter(spotlightContentIntegrityPath(documentId));
      let delivery = getAfter(spotlightDeliveryIntegrityPath(documentId));
      let draft = getAfter(/databases/$(database)/documents/internalFounderWorkflowDrafts/$(data.workflowDraftId));
      return existsAfter(spotlightFactsIntegrityPath(documentId))
        && existsAfter(spotlightFactPartIntegrityPath(documentId, 1))
        && existsAfter(spotlightFactPartIntegrityPath(documentId, 2))
        && existsAfter(spotlightContentIntegrityPath(documentId))
        && existsAfter(spotlightDeliveryIntegrityPath(documentId))
        && existsAfter(spotlightRequestIntegrityPath(documentId))
        && existsAfter(spotlightCustomizationIntegrityPath(documentId))
        && existsAfter(/databases/$(database)/documents/internalFounderWorkflowDrafts/$(data.workflowDraftId))
        && data.factsIntegrityId == documentId
        && data.contentIntegrityId == documentId
        && data.deliveryIntegrityId == documentId
        && data.requestIntegrityId == documentId
        && data.customizationIntegrityId == documentId
        && facts.data.packageId == documentId
        && facts.data.workspaceId == data.workspaceId
        && facts.data.ownerId == data.ownerId
        && content.data.packageId == documentId
        && content.data.workspaceId == data.workspaceId
        && content.data.ownerId == data.ownerId
        && content.data.workflowDraftId == data.workflowDraftId
        && delivery.data.packageId == documentId
        && delivery.data.workspaceId == data.workspaceId
        && delivery.data.ownerId == data.ownerId
        && delivery.data.workflowDraftId == data.workflowDraftId
        && draft.data.id == data.workflowDraftId
        && draft.data.workspaceId == data.workspaceId
        && draft.data.ownerId == data.ownerId
        && draft.data.projectId == data.projectId
        && draft.data.schoolId == data.schoolId
        && draft.data.status == 'active'
        && delivery.data.rightsConfirmed == data.rightsConfirmed;
    }

    function validSpotlightApprovalIntegrity(data, documentId) {
      let deliveryPath = spotlightDeliveryIntegrityPath(documentId);
      let requestPath = spotlightRequestIntegrityPath(documentId);
      let customizationPath = spotlightCustomizationIntegrityPath(documentId);
      let delivery = get(deliveryPath).data;
      let spotlightRequest = get(requestPath).data;
      let spotlightCustomization = get(customizationPath).data;
      return exists(deliveryPath)
        && exists(requestPath) && exists(customizationPath)
        && delivery.packageId == documentId
        && delivery.workspaceId == data.workspaceId
        && delivery.ownerId == data.ownerId
        && delivery.workflowDraftId == data.workflowDraftId
        && delivery.rightsConfirmed == true
        && spotlightRequest.packageId == documentId
        && spotlightRequest.workspaceId == data.workspaceId
        && spotlightRequest.ownerId == data.ownerId
        && spotlightRequest.workflowDraftId == data.workflowDraftId
        && spotlightCustomization.packageId == documentId
        && spotlightCustomization.workspaceId == data.workspaceId
        && spotlightCustomization.ownerId == data.ownerId
        && spotlightCustomization.workflowDraftId == data.workflowDraftId;
    }

    function validSchoolSpotlightPackageShape(data, documentId) {
      return data is map
        && data.keys().hasOnly([
          'id', 'projectId', 'artifactType', 'version', 'status',
          'createdAt', 'updatedAt', 'createdBy', 'workspace',
          'generatedByService', 'summary', 'metadata', 'workspaceId',
          'ownerId', 'projectTitle', 'projectType', 'outlinePackageId',
          'nextRecommendedStep', 'active', 'packageKind', 'workflowDraftId',
          'schoolId', 'rightsConfirmed', 'changeSummary',
          'factsIntegrityId', 'contentIntegrityId', 'deliveryIntegrityId',
          'requestIntegrityId', 'customizationIntegrityId',
          'supersededAt', 'previousPackageId'
        ])
        && data.keys().size() == 29
          + (data.keys().hasAny(['supersededAt']) ? 1 : 0)
          + (data.keys().hasAny(['previousPackageId']) ? 1 : 0)
        && data.id == documentId
        && data.projectId is string
        && data.workspaceId is string && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.workflowDraftId is string && data.schoolId is string
        && data.artifactType == 'production-package'
        && data.status in ['staged', 'ready']
        && data.projectType == 'school-spotlight'
        && data.packageKind == 'school-spotlight'
        && data.workspace == 'production-studio'
        && data.generatedByService == 'production'
        && data.version is int && data.version > 0
        && data.active is bool
        && ((data.status == 'staged' && data.active == false)
          || data.status == 'ready')
        && ((data.version == 1 && !data.keys().hasAny(['previousPackageId']))
          || (data.version > 1 && data.previousPackageId is string))
        && boundedString(data.createdAt, 64) && boundedString(data.updatedAt, 64)
        && (!data.keys().hasAny(['supersededAt'])
          || (boundedString(data.supersededAt, 64) && data.supersededAt.size() > 0))
        && (!data.keys().hasAny(['previousPackageId']) || isIdentifier(data.previousPackageId))
        && data.createdBy == data.ownerId
        && boundedString(data.summary, 20000) && data.summary.size() > 0
        && boundedString(data.projectTitle, 4096) && data.projectTitle.size() > 0
        && data.outlinePackageId == 'outline_' + data.projectId
        && boundedString(data.nextRecommendedStep, 10000) && data.nextRecommendedStep.size() > 0
        && boundedString(data.changeSummary, 10000) && data.changeSummary.size() > 0
        && data.metadata is map
        && data.metadata.keys().hasOnly([
          'workspaceId', 'projectType', 'schoolId', 'workflowDraftId', 'productionComplete'
        ])
        && data.metadata.workspaceId == data.workspaceId
        && data.metadata.projectType == 'school-spotlight'
        && data.metadata.schoolId == data.schoolId
        && data.metadata.workflowDraftId == data.workflowDraftId
        && data.metadata.productionComplete == true
        && data.rightsConfirmed is bool
        && validSchoolSpotlightPackageIntegrity(data, documentId);
    }

    function validFounderDraftRequestBoundary(data) {
      return data is map
        && data.goals is list
        && data.audiences is list
        && data.platforms is list
        && data.media is list
        && data.availableMedia is list
        && data.needShotList is bool
        && data.objective is string
        && data.audience is string
        && data.centralEmphasis is string
        && data.callToAction is string
        && (!('no-media-yet' in data.media) || data.media.size() == 1);
    }

    function validFounderDraftCustomizationBoundary(data) {
      return data is map
        && data.hook is string
        && data.emphasis is string
        && data.callToAction is string
        && data.mediaAvailability is list
        && data.verticalVideoScript is string
        && data.instagramCaption is string
        && data.shotList is list
        && data.rightsConfirmed is bool;
    }

    function validSchoolSpotlightPackageLinkage(data, documentId) {
      let projectPath = /databases/$(database)/documents/internalProjects/$(data.projectId);
      let draftPath = /databases/$(database)/documents/internalFounderWorkflowDrafts/$(data.workflowDraftId);
      let project = getAfter(projectPath).data;
      let draft = getAfter(draftPath).data;
      return validSchoolSpotlightPackageShape(data, documentId)
        && project.workspaceId == data.workspaceId
        && project.ownerId == data.ownerId
        && project.get('projectType', '') == 'school-spotlight'
        && project.get('state', '') == 'production'
        && project.get('status', '') == 'production'
        && project.knowledgeEntityIds is list
        && project.knowledgeEntityIds.hasAny([data.schoolId])
        && (!project.keys().hasAny(['creationRequestId'])
          || project.creationRequestId == data.workflowDraftId
          || project.creationRequestId == 'founder-simple-' + data.workflowDraftId)
        && draft.workspaceId == data.workspaceId
        && draft.ownerId == data.ownerId
        && draft.schoolId == data.schoolId
        && draft.projectId == data.projectId
        && draft.kind == 'school-spotlight'
        && draft.status == 'active';
    }

    function validPreviousSpotlightPackage(data) {
      let previousPackageId = data.get('previousPackageId', 'no-previous-package');
      let previousPath = /databases/$(database)/documents/internalProductionPackages/$(previousPackageId);
      return data.version == 1
        || (existsAfter(previousPath)
          && getAfter(previousPath).data.packageKind == 'school-spotlight'
          && getAfter(previousPath).data.projectId == data.projectId
          && getAfter(previousPath).data.workspaceId == data.workspaceId
          && getAfter(previousPath).data.ownerId == data.ownerId
          && getAfter(previousPath).data.workflowDraftId == data.workflowDraftId
          && getAfter(previousPath).data.schoolId == data.schoolId
          && getAfter(previousPath).data.version == data.version - 1
          && getAfter(previousPath).data.status == 'ready'
          && getAfter(previousPath).data.active == true);
    }

    function schoolSpotlightPackageIdentityPreserved(data, documentId) {
      return resource.data.packageKind == 'school-spotlight'
        && data.ownerId == request.auth.uid
        && data.id == documentId
        && data.id == resource.data.id
        && data.projectId == resource.data.projectId
        && data.workspaceId == resource.data.workspaceId
        && data.ownerId == resource.data.ownerId
        && data.workflowDraftId == resource.data.workflowDraftId
        && data.schoolId == resource.data.schoolId
        && data.version == resource.data.version
        && data.createdAt == resource.data.createdAt;
    }

    function spotlightPackageMayBeSuperseded(data, documentId) {
      let projectPath = /databases/$(database)/documents/internalProjects/$(resource.data.projectId);
      return schoolSpotlightPackageIdentityPreserved(data, documentId)
        && resource.data.active == true
        && data.active == false
        && data.supersededAt is string
        && data.supersededAt.size() > 0
        && data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'supersededAt', 'updatedAt'
        ])
        && (!existsAfter(projectPath)
          || getAfter(projectPath).data.get('approvedSchoolSpotlightPackageId', '') != documentId);
    }

    function spotlightPackageMayBeRestaged(data, documentId) {
      return schoolSpotlightPackageIdentityPreserved(data, documentId)
        && resource.data.status == 'staged'
        && resource.data.active == false
        && data.status == 'staged'
        && data.active == false
        && validSchoolSpotlightPackageLinkage(data, documentId)
        && validPreviousSpotlightPackage(data);
    }

    function spotlightPackageMayBeActivated(data, documentId) {
      let projectPath = /databases/$(database)/documents/internalProjects/$(resource.data.projectId);
      let previousPackageId = resource.data.get('previousPackageId', 'no-previous-package');
      let previousPath = /databases/$(database)/documents/internalProductionPackages/$(previousPackageId);
      return schoolSpotlightPackageIdentityPreserved(data, documentId)
        && resource.data.status == 'staged'
        && resource.data.active == false
        && data.status == 'ready'
        && data.active == true
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'active', 'updatedAt'
        ])
        && existsAfter(projectPath)
        && getAfter(projectPath).data.ownerId == request.auth.uid
        && getAfter(projectPath).data.workspaceId == data.workspaceId
        && getAfter(projectPath).data.get('state', '') == 'production'
        && getAfter(projectPath).data.get('status', '') == 'production'
        && getAfter(projectPath).data.activeSchoolSpotlightPackageId == documentId
        && getAfter(projectPath).data.activeProductionVersion == data.version
        && (data.version == 1
          || (existsAfter(previousPath)
            && getAfter(previousPath).data.projectId == data.projectId
            && getAfter(previousPath).data.workspaceId == data.workspaceId
            && getAfter(previousPath).data.ownerId == data.ownerId
            && getAfter(previousPath).data.workflowDraftId == data.workflowDraftId
            && getAfter(previousPath).data.schoolId == data.schoolId
            && getAfter(previousPath).data.version == data.version - 1
            && getAfter(previousPath).data.status == 'ready'
            && getAfter(previousPath).data.active == false));
    }

    function spotlightIntegrityMayBeWritten(packageId, ownerId, workspaceId) {
      let packagePath = /databases/$(database)/documents/internalProductionPackages/$(packageId);
      return !exists(packagePath)
        || (get(packagePath).data.packageKind == 'school-spotlight'
          && get(packagePath).data.status == 'staged'
          && get(packagePath).data.active == false
          && get(packagePath).data.ownerId == ownerId
          && get(packagePath).data.workspaceId == workspaceId);
    }

    function spotlightApprovalFieldsChanged(data) {
      return data.diff(resource.data).affectedKeys().hasAny([
        'approvedSchoolSpotlightPackageId',
        'approvedSchoolSpotlightPackageVersion'
      ]);
    }

    function founderSimpleProject(data) {
      return data.keys().hasAny([
          'activeSchoolSpotlightPackageId',
          'approvedSchoolSpotlightPackageId',
          'approvedSchoolSpotlightPackageVersion'
        ])
        || data.get('creationRequestId', '').matches('founder-simple-.+');
    }

    function schoolSpotlightProject(data) {
      return data.get('projectType', '') == 'school-spotlight'
        || data.get('type', '') == 'school-spotlight';
    }

    function projectEntersApproved(data) {
      return (data.get('state', '') == 'approved' || data.get('status', '') == 'approved')
        && (resource.data.get('state', '') != 'approved'
          || resource.data.get('status', '') != 'approved');
    }

    function approvedSpotlightPackageMatches(data, documentId) {
      let approvedPackageId = data.get('approvedSchoolSpotlightPackageId', '');
      let approvedPackageVersion = data.get('approvedSchoolSpotlightPackageVersion', 0);
      let packagePath = /databases/$(database)/documents/internalProductionPackages/$(approvedPackageId);
      let spotlightPackage = getAfter(packagePath).data;
      let draftPath = /databases/$(database)/documents/internalFounderWorkflowDrafts/$(spotlightPackage.workflowDraftId);
      let draft = getAfter(draftPath).data;
      return data.id == documentId
        && data.state == 'approved' && data.status == 'approved'
        && resource.data.get('state', '') == 'review'
        && resource.data.get('status', '') == 'review'
        && data.ownerId == request.auth.uid
        && isIdentifier(approvedPackageId)
        && approvedPackageVersion is int
        && approvedPackageVersion > 0
        && approvedPackageId == data.activeSchoolSpotlightPackageId
        && approvedPackageVersion == data.activeProductionVersion
        && existsAfter(packagePath)
        && spotlightPackage.id == approvedPackageId
        && spotlightPackage.packageKind == 'school-spotlight'
        && spotlightPackage.artifactType == 'production-package'
        && spotlightPackage.status == 'ready'
        && spotlightPackage.projectId == documentId
        && spotlightPackage.workspaceId == data.workspaceId
        && spotlightPackage.ownerId == data.ownerId
        && spotlightPackage.version == approvedPackageVersion
        && spotlightPackage.active == true
        && spotlightPackage.rightsConfirmed == true
        && spotlightPackage.factsIntegrityId == approvedPackageId
        && spotlightPackage.contentIntegrityId == approvedPackageId
        && spotlightPackage.deliveryIntegrityId == approvedPackageId
        && spotlightPackage.requestIntegrityId == approvedPackageId
        && spotlightPackage.customizationIntegrityId == approvedPackageId
        && validSpotlightApprovalIntegrity(spotlightPackage, approvedPackageId)
        && data.get('projectType', '') == 'school-spotlight'
        && data.knowledgeEntityIds is list
        && data.knowledgeEntityIds.hasAny([spotlightPackage.schoolId])
        && (!data.keys().hasAny(['creationRequestId'])
          || data.creationRequestId == spotlightPackage.workflowDraftId
          || data.creationRequestId == 'founder-simple-' + spotlightPackage.workflowDraftId)
        && existsAfter(draftPath)
        && draft.id == spotlightPackage.workflowDraftId
        && draft.workspaceId == data.workspaceId
        && draft.ownerId == data.ownerId
        && draft.schoolId == spotlightPackage.schoolId
        && draft.projectId == documentId
        && draft.currentPackageId == approvedPackageId
        && draft.currentPackageVersion == approvedPackageVersion
        && draft.step == 'approve'
        && draft.status == 'active'
        && spotlightRequestMatches(
          draft.request,
          get(spotlightRequestIntegrityPath(approvedPackageId)).data.request
        )
        && spotlightCustomizationMatches(
          draft.customization,
          get(spotlightCustomizationIntegrityPath(approvedPackageId)).data.customization
        )
        && existsAfter(/databases/$(database)/documents/internalKnowledgeNodes/$(spotlightPackage.schoolId))
        && getAfter(/databases/$(database)/documents/internalKnowledgeNodes/$(spotlightPackage.schoolId)).data.id == spotlightPackage.schoolId
        && getAfter(/databases/$(database)/documents/internalKnowledgeNodes/$(spotlightPackage.schoolId)).data.workspaceId == data.workspaceId
        && getAfter(/databases/$(database)/documents/internalKnowledgeNodes/$(spotlightPackage.schoolId)).data.type == 'school'
        && getAfter(/databases/$(database)/documents/internalKnowledgeNodes/$(spotlightPackage.schoolId)).data.status == 'active';
    }

    function validSpotlightProjectCreate(data) {
      return !founderSimpleProject(data)
        || (data.ownerId == request.auth.uid
          && data.get('state', '') != 'approved'
          && data.get('status', '') != 'approved');
    }

    function validSpotlightProjectUpdate(data, documentId) {
      let entersApproved = projectEntersApproved(data);
      let exactApprovalRequired = schoolSpotlightProject(resource.data)
        || schoolSpotlightProject(data)
        || founderSimpleProject(resource.data)
        || founderSimpleProject(data);
      return (!exactApprovalRequired && !spotlightApprovalFieldsChanged(data))
        || (exactApprovalRequired
          && resource.data.ownerId == request.auth.uid
          && data.ownerId == request.auth.uid
          && !entersApproved
          && !spotlightApprovalFieldsChanged(data))
        || (exactApprovalRequired
          && resource.data.ownerId == request.auth.uid
          && data.ownerId == request.auth.uid
          && entersApproved
          && spotlightApprovalFieldsChanged(data)
          && approvedSpotlightPackageMatches(data, documentId));
    }

    match /internalProductionPackages/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && (!isSchoolSpotlightPackage(request.resource.data)
          || (request.resource.data.status == 'staged'
            && request.resource.data.active == false
            && validSchoolSpotlightPackageLinkage(request.resource.data, documentId)
            && validPreviousSpotlightPackage(request.resource.data)));
      allow update: if isAdmin()
        && ((!isSchoolSpotlightPackage(resource.data)
            && !isSchoolSpotlightPackage(request.resource.data))
          || spotlightPackageMayBeSuperseded(request.resource.data, documentId)
          || spotlightPackageMayBeRestaged(request.resource.data, documentId)
          || spotlightPackageMayBeActivated(request.resource.data, documentId));
      allow delete: if isAdmin() && !isSchoolSpotlightPackage(resource.data);
    }

    match /internalSchoolSpotlightPackageFacts/{documentId} {
      allow read: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && validSpotlightFactsIntegrity(request.resource.data, documentId);
      allow update: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validSpotlightFactsIntegrity(request.resource.data, documentId);
      allow delete: if false;
    }

    match /internalSchoolSpotlightPackageFactsA/{documentId} {
      allow read: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          request.resource.data.packageId,
          request.resource.data.ownerId,
          request.resource.data.workspaceId)
        && validSpotlightFactPartIntegrity(request.resource.data, documentId);
      allow update: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          request.resource.data.packageId,
          request.resource.data.ownerId,
          request.resource.data.workspaceId)
        && request.resource.data.packageId == resource.data.packageId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validSpotlightFactPartIntegrity(request.resource.data, documentId);
      allow delete: if false;
    }

    match /internalSchoolSpotlightPackageFactsB/{documentId} {
      allow read: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          request.resource.data.packageId,
          request.resource.data.ownerId,
          request.resource.data.workspaceId)
        && validSpotlightFactPartIntegrity(request.resource.data, documentId);
      allow update: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          request.resource.data.packageId,
          request.resource.data.ownerId,
          request.resource.data.workspaceId)
        && request.resource.data.packageId == resource.data.packageId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validSpotlightFactPartIntegrity(request.resource.data, documentId);
      allow delete: if false;
    }

    match /internalSchoolSpotlightPackageContent/{documentId} {
      allow read: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && validSpotlightContentIntegrity(request.resource.data, documentId);
      allow update: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validSpotlightContentIntegrity(request.resource.data, documentId);
      allow delete: if false;
    }

    match /internalSchoolSpotlightPackageDelivery/{documentId} {
      allow read: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && validSpotlightDeliveryIntegrity(request.resource.data, documentId);
      allow update: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validSpotlightDeliveryIntegrity(request.resource.data, documentId);
      allow delete: if false;
    }

    match /internalSchoolSpotlightPackageRequest/{documentId} {
      allow read: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && validSpotlightRequestIntegrity(request.resource.data, documentId);
      allow update: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validSpotlightRequestIntegrity(request.resource.data, documentId);
      allow delete: if false;
    }

    match /internalSchoolSpotlightPackageCustomization/{documentId} {
      allow read: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && validSpotlightCustomizationIntegrity(request.resource.data, documentId);
      allow update: if isAdmin()
        && spotlightIntegrityMayBeWritten(
          documentId, request.resource.data.ownerId, request.resource.data.workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validSpotlightCustomizationIntegrity(request.resource.data, documentId);
      allow delete: if false;
    }

    match /internalProjects/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validSpotlightProjectCreate(request.resource.data);
      allow update: if isAdmin()
        && validSpotlightProjectUpdate(request.resource.data, documentId);
      allow delete: if isAdmin();
    }

    function validFounderWorkflowDraftShape(data, documentId) {
      return data.keys().size() == 14
          + (data.keys().hasAny(['schoolDraft']) ? 1 : 0)
          + (data.keys().hasAny(['schoolId']) ? 1 : 0)
          + (data.keys().hasAny(['projectId']) ? 1 : 0)
          + (data.keys().hasAny(['currentPackageId']) ? 1 : 0)
          + (data.keys().hasAny(['currentPackageVersion']) ? 1 : 0)
        && data.id == documentId && isIdentifier(data.id)
        && isIdentifier(data.workspaceId) && isIdentifier(data.ownerId)
        && data.kind == 'school-spotlight'
        && data.step in ['request', 'review', 'customize', 'approve']
        && data.status in ['active', 'completed', 'archived']
        && (!data.keys().hasAny(['schoolDraft']) || validFounderSchoolDraft(data.schoolDraft))
        && optionalIdentifier(data, 'schoolId')
        && optionalIdentifier(data, 'projectId')
        && optionalIdentifier(data, 'currentPackageId')
        && (!data.keys().hasAny(['currentPackageVersion'])
          || (data.currentPackageVersion is int && data.currentPackageVersion > 0))
        && data.request is map
        && data.facts is list && data.facts.size() <= 32
        && data.customization is map
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && isIdentifier(data.createdBy) && isIdentifier(data.updatedBy)
        && data.revision is int && data.revision > 0;
    }

    function validFounderWorkflowDraft(data, documentId) {
      return validFounderWorkflowDraftShape(data, documentId)
        && data.step == 'request'
        && data.status == 'active'
        && data.facts.size() == 0;
    }

    function validFounderWorkflowDraftUpdate(data, previous) {
      let changed = data.diff(previous).affectedKeys();
      let validateRequest = changed.hasAny(['request']);
      let validateCustomization = changed.hasAny(['customization']);
      return changed.hasOnly([
          'step', 'status', 'schoolDraft', 'schoolId', 'projectId', 'request',
          'facts', 'customization', 'currentPackageId', 'currentPackageVersion',
          'updatedAt', 'updatedBy', 'revision'
        ])
        && (!changed.hasAny(['step'])
          || data.step in ['request', 'review', 'customize', 'approve'])
        && (!changed.hasAny(['status'])
          || data.status in ['active', 'completed', 'archived'])
        && (!changed.hasAny(['schoolDraft'])
          || !data.keys().hasAny(['schoolDraft'])
          || validFounderSchoolDraft(data.schoolDraft))
        && (!changed.hasAny(['schoolId'])
          || !data.keys().hasAny(['schoolId'])
          || isIdentifier(data.schoolId))
        && (!changed.hasAny(['projectId'])
          || !data.keys().hasAny(['projectId'])
          || isIdentifier(data.projectId))
        && (!changed.hasAny(['currentPackageId'])
          || !data.keys().hasAny(['currentPackageId'])
          || isIdentifier(data.currentPackageId))
        && (!changed.hasAny(['currentPackageVersion'])
          || !data.keys().hasAny(['currentPackageVersion'])
          || (data.currentPackageVersion is int && data.currentPackageVersion > 0))
        && (!changed.hasAny(['facts'])
          || (data.facts is list && data.facts.size() <= 32))
        && (!validateRequest || validFounderDraftRequestBoundary(data.request))
        && (!validateCustomization || validFounderDraftCustomizationBoundary(data.customization))
        && data.updatedAt is timestamp
        && isIdentifier(data.updatedBy)
        && data.revision is int && data.revision > 0;
    }

    match /internalFounderWorkflowDrafts/{documentId} {
      // Workflow drafts are private, incomplete Founder work. Existing
      // documents are readable only by their authenticated owner for both
      // direct reads and queries. A missing-document get is allowed only so
      // the client can atomically attempt a first create; it reveals no data
      // and does not relax the owner check for any existing document.
      allow get: if isAdmin()
        && (!exists(/databases/$(database)/documents/internalFounderWorkflowDrafts/$(documentId))
          || resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && validFounderWorkflowDraft(request.resource.data, documentId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == 1;
      allow update: if isAdmin()
        && validFounderWorkflowDraftUpdate(request.resource.data, resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if !isRestrictedInternalCollection(collectionName)
        && (publishedRead() || isAdmin());
      allow create, update, delete: if !isRestrictedInternalCollection(collectionName) && isAdmin();
    }
  }
}
